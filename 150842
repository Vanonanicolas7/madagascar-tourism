// ========================================
// FIREBASE
// Madagascar Tourism - Reservations
// ========================================

import { initializeApp } from
"https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

import {
  getFirestore,
  collection,
  addDoc,
  serverTimestamp
} from
"https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";


// ========================================
// FIREBASE CONFIG
// ========================================

const firebaseConfig = {

  apiKey: "AIzaSyCzjryit_T8PHpD9D7xdmxUheBU6gQ4n14",

  authDomain:
    "madagascar-tourism.firebaseapp.com",

  projectId:
    "madagascar-tourism",

  storageBucket:
    "madagascar-tourism.firebasestorage.app",

  messagingSenderId:
    "1098060851073",

  appId:
    "1:1098060851073:web:ec08253935f77354beea80"

};


// ========================================
// INITIALISATION
// ========================================

const app =
  initializeApp(firebaseConfig);

const db =
  getFirestore(app);


// ========================================
// ELEMENTS
// ========================================

const form =
  document.getElementById(
    "reservationForm"
  );

const destination =
  document.getElementById(
    "destination"
  );

const successMessage =
  document.getElementById(
    "successMessage"
  );

const whatsappLink =
  document.getElementById(
    "whatsappLink"
  );


// ========================================
// DESTINATION AUTOMATIQUE
// ========================================

const params =
  new URLSearchParams(
    window.location.search
  );

const destinationParam =
  params.get("destination");

if (destinationParam) {

  for (
    let i = 0;
    i < destination.options.length;
    i++
  ) {

    if (
      destination.options[i]
        .value
        .toLowerCase() ===
      destinationParam
        .toLowerCase()
    ) {

      destination.value =
        destination.options[i].value;

      break;
    }
  }
}


// ========================================
// ENVOYER RESERVATION
// ========================================

form.addEventListener(
  "submit",
  async function(event) {

    event.preventDefault();


    // -----------------------------
    // Recuperation des données
    // -----------------------------

    const nom =
      document.getElementById(
        "name"
      ).value.trim();

    const telephone =
      document.getElementById(
        "phone"
      ).value.trim();

    const email =
      document.getElementById(
        "email"
      ).value.trim();

    const selectedDestination =
      destination.value;

    const date =
      document.getElementById(
        "date"
      ).value;

    const personnes =
      Number(
        document.getElementById(
          "people"
        ).value
      );

    const message =
      document.getElementById(
        "message"
      ).value.trim();


    // -----------------------------
    // Vérification
    // -----------------------------

    if (
      !nom ||
      !telephone ||
      !selectedDestination ||
      !date ||
      !personnes
    ) {

      alert(
        "Veuillez remplir tous les champs obligatoires."
      );

      return;
    }


    // -----------------------------
    // Désactiver bouton
    // -----------------------------

    const button =
      form.querySelector(
        'button[type="submit"]'
      );

    const oldText =
      button.textContent;

    button.disabled = true;

    button.textContent =
      "⏳ Enregistrement...";


    try {

      // ---------------------------
      // FIRESTORE
      // ---------------------------

      await addDoc(
        collection(
          db,
          "reservations"
        ),
        {

          nom: nom,

          telephone: telephone,

          email: email,

          destination:
            selectedDestination,

          date: date,

          personnes: personnes,

          message: message,

          dateCreation:
            serverTimestamp(),

          statut:
            "nouvelle"

        }
      );


      // ---------------------------
      // WHATSAPP
      // ---------------------------

      const whatsappNumber =
        "261384147899";

      let text =
        "Bonjour Madagascar Tourism !\n\n";

      text +=
        "📅 DEMANDE DE RÉSERVATION\n\n";

      text +=
        "👤 Nom : " +
        nom +
        "\n";

      text +=
        "📱 Téléphone : " +
        telephone +
        "\n";

      text +=
        "🌍 Destination : " +
        selectedDestination +
        "\n";

      text +=
        "📅 Date : " +
        date +
        "\n";

      text +=
        "👥 Personnes : " +
        personnes +
        "\n";

      if (email) {

        text +=
          "✉️ Email : " +
          email +
          "\n";
      }

      if (message) {

        text +=
          "💬 Message : " +
          message +
          "\n";
      }

      text +=
        "\nMerci.";


      whatsappLink.href =
        "https://wa.me/" +
        whatsappNumber +
        "?text=" +
        encodeURIComponent(
          text
        );


      // ---------------------------
      // SUCCESS
      // ---------------------------

      successMessage.style.display =
        "block";

      form.reset();

      successMessage.scrollIntoView({
        behavior: "smooth"
      });


    } catch (error) {

      console.error(
        "Firebase error:",
        error
      );

      alert(
        "❌ Impossible d'enregistrer la réservation. Vérifiez votre connexion."
      );

    }


    // -----------------------------
    // Réactiver bouton
    // -----------------------------

    button.disabled = false;

    button.textContent =
      oldText;

  }
);