<!DOCTYPE html>
<html lang="fr">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Réservation touristique à Madagascar."
  >

  <title>
    Réservation | Madagascar Tourism
  </title>

  <link
    rel="icon"
    href="favicon.svg"
    type="image/svg+xml"
  >

  <link
    rel="stylesheet"
    href="style.css"
  >

</head>


<body>


<!-- ======================================
     HEADER
====================================== -->

<header>

  <div class="logo">
    🇲🇬 Madagascar Tourism
  </div>


  <button
    class="menu-btn"
    aria-label="Ouvrir le menu"
  >
    ☰
  </button>


  <nav>

    <a href="index.html">
      Accueil
    </a>

    <a href="index.html#destinations">
      Destinations
    </a>

    <a href="index.html#about">
      À propos
    </a>

    <a href="index.html#contact">
      Contact
    </a>

    <a href="reservation.html">
      Réservation
    </a>

  </nav>

</header>



<!-- ======================================
     PAGE RESERVATION
====================================== -->

<main class="reservation-page">


  <!-- ====================================
       FORMULAIRE
  ===================================== -->

  <section class="reservation-container">


    <div class="section-title">

      <h1>
        📅 Réservation
      </h1>

      <p>
        Préparez votre prochaine découverte
        de Madagascar.
      </p>

    </div>



    <form id="reservationForm">


      <!-- NOM -->

      <div class="form-group">

        <label for="name">
          👤 Nom complet
        </label>

        <input
          type="text"
          id="name"
          placeholder="Votre nom complet"
          required
        >

      </div>



      <!-- TELEPHONE -->

      <div class="form-group">

        <label for="phone">
          📱 Téléphone
        </label>

        <input
          type="tel"
          id="phone"
          placeholder="Votre numéro"
          required
        >

      </div>



      <!-- EMAIL -->

      <div class="form-group">

        <label for="email">
          ✉️ Email
        </label>

        <input
          type="email"
          id="email"
          placeholder="Votre email"
        >

      </div>



      <!-- DESTINATION -->

      <div class="form-group">

        <label for="destination">
          🌍 Destination
        </label>

        <select
          id="destination"
          required
        >

          <option value="">
            -- Choisir une destination --
          </option>

          <option value="Nosy Be">
            🏝️ Nosy Be
          </option>

          <option value="Nosy Tanikely">
            🌊 Nosy Tanikely
          </option>

          <option value="Isalo">
            🏜️ Isalo
          </option>

          <option value="Andringitra">
            ⛰️ Andringitra
          </option>

          <option value="Ranomafana">
            🌿 Ranomafana
          </option>

          <option value="Andasibe">
            🌳 Andasibe
          </option>

          <option value="Avenue des Baobabs">
            🌴 Avenue des Baobabs
          </option>

          <option value="Tsingy">
            🪨 Tsingy
          </option>

        </select>

      </div>



      <!-- DATE -->

      <div class="form-group">

        <label for="date">
          📅 Date souhaitée
        </label>

        <input
          type="date"
          id="date"
          required
        >

      </div>



      <!-- PERSONNES -->

      <div class="form-group">

        <label for="people">
          👥 Nombre de personnes
        </label>

        <input
          type="number"
          id="people"
          min="1"
          max="50"
          value="1"
          required
        >

      </div>



      <!-- MESSAGE -->

      <div class="form-group">

        <label for="message">
          💬 Message
        </label>

        <textarea
          id="message"
          rows="5"
          placeholder="Informations supplémentaires..."
        ></textarea>

      </div>



      <!-- BOUTON -->

      <button
        type="submit"
        class="destination-reserve"
      >
        💾 Enregistrer la réservation
      </button>


    </form>



    <!-- ==================================
         MESSAGE SUCCÈS
    =================================== -->

    <div
      id="successMessage"
      style="display:none;"
    >

      <h2>
        ✅ Réservation enregistrée
      </h2>

      <p>
        Votre réservation a été enregistrée
        avec succès.
      </p>


      <a
        id="whatsappLink"
        class="whatsapp-btn"
        target="_blank"
        rel="noopener"
      >
        💬 Envoyer sur WhatsApp
      </a>

    </div>


  </section>



  <!-- ====================================
       INFORMATION
  ===================================== -->

  <section class="reservation-container">


    <div class="section-title">

      <h2>
        🇲🇬 Madagascar Tourism
      </h2>

      <p>
        Votre demande sera enregistrée
        et notre équipe pourra vous contacter
        pour confirmer votre réservation.
      </p>

    </div>


  </section>


</main>



<!-- ======================================
     FOOTER
====================================== -->

<footer>

  <div class="footer-content">

    <h3>
      🇲🇬 Madagascar Tourism
    </h3>

    <p>
      Découvrez la beauté de Madagascar.
    </p>

  </div>


  <div class="footer-bottom">

    <p>
      © 2026 Madagascar Tourism.
      Tous droits réservés.
    </p>

  </div>

</footer>



<!-- ======================================
     SCRIPTS
====================================== -->

<script
  type="module"
  src="reservation.js"
></script>

<script src="script.js"></script>


</body>

</html>